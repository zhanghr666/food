        "viewName": "food_items",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT m.id, m.entryToken, m.name, m.category, m.quantity, m.quantitySpecified, m.unit, m.purchaseDate, f.productionDate, f.expiryDate, f.dateKind, f.shelfLifeAmount, f.shelfLifeUnit, m.location, m.note, m.brand, m.specification, m.price, m.source, m.archived, m.createdAt, m.updatedAt FROM managed_items AS m INNER JOIN food_details AS f ON m.id = f.itemId WHERE m.kind = 'food'"
      }
